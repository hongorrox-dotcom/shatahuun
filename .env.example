# Энэ файлыг .env нэрээр хуулж, утгуудаа оруулна уу. .env файлыг хэнтэй ч хуваалцахгүй.
ANTHROPIC_API_KEY=sk-ant-...

# Туслахын загвар ба бодох гүн (заавал биш)
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max — чат-д medium хангалттай, өндөр болгох тусам удаан, үнэтэй
ANTHROPIC_EFFORT=medium

# Сервер (заавал биш). HOST=0.0.0.0 болговол сүлжээний бусад компьютер хандах боломжтой.
PORT=3000
HOST=127.0.0.1
